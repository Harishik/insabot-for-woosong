# App
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+psycopg://insabot:insabot@localhost:5432/insabot
POSTGRES_DB=insabot
POSTGRES_USER=insabot
POSTGRES_PASSWORD=insabot

# Auth
JWT_SECRET=change-me-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Ollama default
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
DEMO_MODE=false

# Optional swappable providers
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Crawler
CRAWL_USER_AGENT=InsaBotForWoosong/1.0 (+https://english.wsu.ac.kr)
CRAWL_MAX_PAGES=80
CRAWL_REQUEST_TIMEOUT_SECONDS=20
CRAWL_RATE_LIMIT_SECONDS=2
CRAWL_REQUIRE_APPROVAL=true

# Optional Redis
REDIS_URL=redis://localhost:6379/0
